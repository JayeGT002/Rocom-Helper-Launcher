{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RocomHelper Launcher",
  "version": "1.0.0",
  "identifier": "com.rocom.helper-launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Rocom Helper Launcher",
        "width": 820,
        "height": 540,
        "resizable": true,
        "minWidth": 680,
        "minHeight": 440,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
